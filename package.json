{
"name": "hello-world-do-template",
"version": "1.0.0",
"description": "FlyTripVisa | 飞行旅行签证 - Production Global Business & Residency Partner Platform",
"main": "src/server.ts",
"scripts": {
"dev": "wrangler dev",
"build": "tsc --noEmit",
"deploy": "wrangler deploy",
"db:migrate": "wrangler d1 migrations apply flytripvisa-db --remote",
"db:migrate:local": "wrangler d1 migrations apply flytripvisa-db --local",
"db:migrate:remote": "wrangler d1 migrations apply flytripvisa-db --remote",
"db:seed": "wrangler d1 execute flytripvisa-db --local --file=./migrations/seed.sql",
"db:seed:remote": "wrangler d1 execute flytripvisa-db --remote --file=./migrations/seed.sql",
"typecheck": "tsc --noEmit"
},
"keywords": [
"cloudflare",
"workers",
"d1",
"r2",
"kv",
"durable-objects",
"workers-ai",
"flytripvisa"
],
"author": "FlyTripVisa Technical Operations",
"license": "UNLICENSED",
"devDependencies": {
"@cloudflare/workers-types": "^4.20240815.0",
"typescript": "^5.5.4",
"wrangler": "^3.72.0"
}
}